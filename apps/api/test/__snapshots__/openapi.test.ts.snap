    "/api/v1/rooms/seed": {
      "post": {
        "operationId": "postApiV1RoomsSeed",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "room": {
                    "description": "A playground room: playground: and a lower-case UUID",
                    "pattern": "^playground:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                    "type": "string",
                  },
                  "seed": {
                    "additionalProperties": false,
                    "properties": {
                      "blocks": {
                        "additionalProperties": {
                          "additionalProperties": false,
                          "properties": {
                            "fields": {
                              "additionalProperties": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                  },
                                  {
                                    "items": {
                                      "anyOf": [
                                        {
                                          "additionalItems": false,
                                          "items": [
                                            {
                                              "type": "string",
                                            },
                                          ],
                                          "minItems": 1,
                                          "type": "array",
                                        },
                                        {
                                          "additionalItems": false,
                                          "items": [
                                            {
                                              "type": "string",
                                            },
                                            {},
                                          ],
                                          "minItems": 2,
                                          "type": "array",
                                        },
                                      ],
                                    },
                                    "type": "array",
                                  },
                                ],
                              },
                              "propertyNames": {
                                "minLength": 1,
                                "type": "string",
                              },
                              "type": "object",
                            },
                            "parent": {
                              "anyOf": [
                                {
                                  "minLength": 1,
                                  "type": "string",
                                },
                                {
                                  "type": "null",
                                },
                              ],
                            },
                            "position": {
                              "minLength": 1,
                              "type": "string",
                            },
                            "props": {},
                            "slot": {
                              "anyOf": [
                                {
                                  "minLength": 1,
                                  "type": "string",
                                },
                                {
                                  "type": "null",
                                },
                              ],
                            },
                            "type": {
                              "minLength": 1,
                              "type": "string",
                            },
                          },
                          "required": [
                            "type",
                            "props",
                            "parent",
                            "slot",
                            "position",
                            "fields",
                          ],
                          "type": "object",
                        },
                        "propertyNames": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "type": "object",
                      },
                      "version": {
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "version",
                      "blocks",
                    ],
                    "type": "object",
                  },
                },
                "required": [
                  "room",
                  "seed",
                ],
                "type": "object",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "room": {
                      "type": "string",
                    },
