{
  "name": "fancyfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -p tests/tooling && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "e2e": "pnpm -r --if-present run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
