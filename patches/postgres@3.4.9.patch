index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..ea237b7743c1b8c6903fabfddef3a8e514e019d2 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -254,6 +254,16 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function nextWrite(fn) {
+    if (!socket) {
+      clearImmediate(nextWriteTimer)
+      chunk = nextWriteTimer = null
+      const err = Errors.connection('CONNECTION_CLOSED', options)
+      query && queryError(query, err)
+      while (sent.length)
+        queryError(sent.shift(), err)
+      return false
+    }
+
     const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
